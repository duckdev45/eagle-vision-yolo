# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Virtual environment
venv/
.venv/
env/

# IDE / Editor files
.idea/
.vscode/

# OS / System files
.DS_Store
Thumbs.db

# Python specific data and build artifacts
dist/
build/
*.egg-info/
.pytest_cache/
*.cache

# Environment variables, credentials, local data (based on user request)
# Backup or local configuration files should be ignored.
.env*
*.bak*
*.local

# ML Model outputs and large data
data/
models/
*.pkl
*.pt
*.pth
*.h5

# 公司資料不上 git（QS 標準、合約工作約定、請款項、labels 對應）。
# 2026-09-01 起以 git-filter-repo 從全部歷史移除；此規則防止再次誤加。
reference/

# 評估報告：含真實工地照片與日報 title（公開 repo 不可推）。
# JOURNAL.md 純文字統計要進版控時用 git add -f reports/JOURNAL.md。
reports/

# Git metadata (though usually ignored by default, explicit is safer)
.git/

# Logs and temporary files
*.log
tmp/
# YOLO 煙霧測試輸出（val 圖含外部資料集樣本）
runs/

# 從 QS／合約推導出來的活文件（含工序原文與條號）＝公司資料。
# 2026-10-09 從版控移出；本機要留隨意，但不要再 git add。
/phase-report.html
/qs-phases.html